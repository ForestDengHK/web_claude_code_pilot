{
  "name": "codepilot",
  "version": "0.11.0",
  "private": true,
  "author": {
    "name": "op7418",
    "email": "7418@openclaw.ai"
  },
  "description": "A web GUI for Claude Code",
  "scripts": {
    "dev": "cross-env HOSTNAME=0.0.0.0 next dev --turbopack",
    "dev:ccr": "cross-env HOSTNAME=0.0.0.0 PORT=4007 CLAUDE_GUI_DATA_DIR=$HOME/.codepilot-ccr next dev --turbopack",
    "build": "next build && node scripts/prepare-server.mjs",
    "server": "node .next/standalone/codepilot-server.js",
    "start": "npm run server",
    "lint": "eslint",
    "test": "node --import tsx --test src/__tests__/unit/*.test.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "terminal-ws": "TERMINAL_WS_PORT=4003 tsx --watch scripts/terminal-ws-server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run terminal-ws\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.158",
    "@anthropic-ai/sdk": "^0.96.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@shikijs/markdown-it": "^3.23.0",
    "@streamdown/cjk": "^1.0.1",
    "@streamdown/code": "^1.0.1",
    "@streamdown/math": "^1.0.1",
    "@streamdown/mermaid": "^1.0.1",
    "@types/markdown-it": "^14.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.73",
    "ansi-to-react": "^6.2.6",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^9.1.0",
    "github-markdown-css": "^5.9.0",
    "lucide-react": "^0.563.0",
    "markdown-it": "^14.1.1",
    "motion": "^12.33.0",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.1.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
